diff --git a/src/lib/tmux-client.grouped.test.ts b/src/lib/tmux-client.grouped.test.ts
new file mode 100644
index 0000000..0435655
--- /dev/null
+++ b/src/lib/tmux-client.grouped.test.ts
@@ -0,0 +1,78 @@
+// Grouped sessions (one view per terminal) against a real tmux: a jump pinned with targetForClient
+// moves only the jumping terminal, even when the other terminal was active last.
+// Its own two servers by socket path; refuses to run with $TMUX set, so it can never reach the
+// developer's server. The "terminals" are panes of the outer server attached to the inner one.
+import { afterAll, beforeAll, describe, expect, it } from "bun:test";
+import { mkdtempSync, rmSync } from "fs";
+import { tmpdir } from "os";
+import { join } from "path";
+import { resetTmuxSocketCache } from "./tmux-socket";
+import { targetForClient } from "./tmux-client";
+
+const tmuxBin = Bun.which("tmux");
+const skip = !tmuxBin || Boolean(process.env.TMUX);
+const dir = mkdtempSync(join(tmpdir(), "ccmux-grouped-"));
+const inner = join(dir, "inner.sock");
+const outer = join(dir, "outer.sock");
+const run = (socket: string, ...args: string[]): string => {
+  const env = { ...process.env };
+  delete env.TMUX;
+  delete env.TMUX_PANE;
+  const proc = Bun.spawnSync([tmuxBin!, "-S", socket, ...args], { env, stdout: "pipe", stderr: "pipe" });
+  if (proc.exitCode !== 0) throw new Error(`tmux ${args.join(" ")}: ${proc.stderr.toString()}`);
+  return proc.stdout.toString().trim();
+};
+const sleep = (ms: number) => new Promise((done) => setTimeout(done, ms));
+
+describe.skipIf(skip)("targetForClient with grouped views (real tmux)", () => {
+  const previousSocket = process.env.CCMUX_TMUX_SOCKET;
+  let paneA = "", paneB = "", ttyA = "";
+  const windowOf = (session: string) => run(inner, "display-message", "-p", "-t", session, "#{window_id}");
+  const sessionOfClient = (tty: string) =>
+    run(inner, "list-clients", "-F", "#{client_tty} #{session_name}").split("\n")
+      .map((line) => line.split(" ")).find(([t]) => t === tty)?.[1];
+
+  beforeAll(async () => {
+    process.env.CCMUX_TMUX_SOCKET = inner;
+    resetTmuxSocketCache();
+    run(inner, "-f", "/dev/null", "new-session", "-d", "-s", "ws", "sleep 100000");
+    paneA = run(inner, "display-message", "-p", "-t", "ws", "#{pane_id}");
+    paneB = run(inner, "new-window", "-d", "-P", "-F", "#{pane_id}", "-t", "ws:", "sleep 100000");
+    run(inner, "new-session", "-d", "-t", "ws", "-s", "va");
+    run(inner, "new-session", "-d", "-t", "ws", "-s", "vb");
+    run(inner, "select-window", "-t", `vb:${run(inner, "display-message", "-p", "-t", paneB, "#{window_id}")}`);
+    const attach = (session: string) => `env -u TMUX ${tmuxBin} -S ${inner} attach -t ${session}`;
+    run(outer, "-f", "/dev/null", "new-session", "-d", "-s", "a", "-x", "80", "-y", "24", attach("va"));
+    run(outer, "new-session", "-d", "-s", "b", "-x", "80", "-y", "24", attach("vb"));
+    ttyA = run(outer, "display-message", "-p", "-t", "a", "#{pane_tty}");
+    for (let i = 0; i < 50 && run(inner, "list-clients", "-F", "x").split("\n").length < 2; i++) await sleep(100);
+  });
+
+  afterAll(() => {
+    for (const socket of [outer, inner]) try { run(socket, "kill-server"); } catch {}
+    rmSync(dir, { recursive: true, force: true });
+    if (previousSocket === undefined) delete process.env.CCMUX_TMUX_SOCKET;
+    else process.env.CCMUX_TMUX_SOCKET = previousSocket;
+    resetTmuxSocketCache();
+  });
+
+  it("keeps the jump in the jumping terminal's view when the other was active last", async () => {
+    const before = windowOf("vb");
+    run(outer, "send-keys", "-t", "b", "x");  // terminal B active last
+    await sleep(300);
+    run(inner, "select-window", "-t", `va:${run(inner, "display-message", "-p", "-t", paneB, "#{window_id}")}`);
+
+    const target = await targetForClient(ttyA, paneA);
+    expect(target).toMatch(/^\$\d+:@\d+\.%\d+$/);
+    run(inner, "switch-client", "-c", ttyA, "-t", target);
+
+    expect(sessionOfClient(ttyA)).toBe("va");
+    expect(windowOf("va")).toBe(run(inner, "display-message", "-p", "-t", paneA, "#{window_id}"));
+    expect(windowOf("vb")).toBe(before);
+  });
+
+  it("leaves a target its client's session lacks unchanged", async () => {
+    expect(await targetForClient("/dev/no-such-client", paneA)).toBe(paneA);
+    expect(await targetForClient(ttyA, "%99999")).toBe("%99999");
+  });
+});
diff --git a/src/lib/tmux-client.ts b/src/lib/tmux-client.ts
index 59e7654..6a92ddf 100644
--- a/src/lib/tmux-client.ts
+++ b/src/lib/tmux-client.ts
@@ -316,3 +316,55 @@ export async function resolvePinnedTmuxClientTty(): Promise<ResolvedClientTty> {
   if (current && CLIENT_TTY_PATTERN.test(current)) return { tty: current };
   return { tty: null, refusal: "no-client" };
 }
+
+/**
+ * A `%N` pane or `@N` window target pinned to one session: `$S:@W` or
+ * `$S:@W.%P`, when that session has the window. Otherwise the target as given.
+ *
+ * Grouped sessions (one view per terminal, sharing every window) make a bare
+ * pane or window target ambiguous: tmux resolves it in the most recently
+ * active session that has the window, which can be ANOTHER terminal's view, so
+ * `switch-client -c A -t %5` moved terminal B to %5's window and A into B's
+ * view. Naming A's own session keeps the jump on A. tmux rejects `$S:%P`, so
+ * the window id is looked up. One tmux invocation answers both questions; any
+ * failure falls back to the bare target, the ungrouped behavior unchanged.
+ */
+export async function targetForClient(
+  clientTty: string,
+  target: string,
+): Promise<string> {
+  return pinTarget(target, { clientTty });
+}
+
+/** {@link targetForClient} for a session already known. */
+export async function targetInSession(
+  sessionId: string | null | undefined,
+  target: string,
+): Promise<string> {
+  return sessionId ? pinTarget(target, { sessionId }) : target;
+}
+
+async function pinTarget(
+  target: string,
+  owner: { clientTty?: string; sessionId?: string },
+): Promise<string> {
+  if (!/^[%@]\d+$/.test(target)) return target;
+  const panes = ["list-panes", "-a", "-F", ["P", "#{session_id}", "#{window_id}", "#{pane_id}"].join(PANE_FIELD_SEP)];
+  const args = owner.clientTty
+    ? ["list-clients", "-F", ["C", "#{client_tty}", "#{session_id}"].join(PANE_FIELD_SEP), ";", ...panes]
+    : panes;
+  let out: string;
+  try {
+    const proc = Bun.spawn(tmuxArgv(...args), { stdout: "pipe", stderr: "ignore" });
+    out = await new Response(proc.stdout).text();
+    if ((await proc.exited) !== 0) return target;
+  } catch {
+    return target;
+  }
+  const rows = out.split("\n").map((line) => line.split(PANE_FIELD_SEP));
+  const session = owner.sessionId ?? rows.find(([kind, tty]) => kind === "C" && tty === owner.clientTty)?.[2];
+  if (!session) return target;
+  const row = rows.find(([kind, s, w, p]) => kind === "P" && s === session && (p === target || w === target));
+  if (!row) return target;
+  return target.startsWith("%") ? `${session}:${row[2]}.${target}` : `${session}:${row[2]}`;
+}
