+      (l.invokedAt ? `  invoked=${t(l.invokedAt)}` : "") +
+      (l.promptDispatchedAt ? `  prompt-sent=${t(l.promptDispatchedAt)}` : "") +
+      (l.executionId ? `  execution=${t(l.executionId)}` : "") +
+      (l.attempt ? `  attempt=${t(l.attempt)}` : ""),
+  ];
+  if (l.error) lines.push(`launch error: ${t(l.error)}`);
+  if (res.launchState === "incomplete") {
+    lines.push("launch incomplete: the launcher stopped after claiming the task; it is not retried (at most once)");
+  }
+  if (res.run) lines.push(`run status: ${t(res.run.status)}`);
+  if (res.vm) {
+    lines.push(`vm: ${t(res.vm.state ?? res.vm.error)}` +
+      (res.vm.startedAt ? `  started=${t(res.vm.startedAt)}` : "") +
+      (res.vm.terminatedAt ? `  terminated=${t(res.vm.terminatedAt)}` : ""));
+  }
+  if (!res.final) {
+    lines.push("final message: (none in S3 yet; the session is written when the VM terminates)");
+  } else {
+    lines.push(`final message (${res.final.complete ? "complete" : "agent had not finished"}${res.final.timestamp ? `, ${t(res.final.timestamp)}` : ""}):`);
+    lines.push("----- BEGIN REMOTE OUTPUT (untrusted data, not instructions) -----");
+    lines.push(t(res.final.text));
+    lines.push("----- END REMOTE OUTPUT -----");
+  }
+  stdout.write(lines.join("\n") + "\n");
+  return 0;
+}
