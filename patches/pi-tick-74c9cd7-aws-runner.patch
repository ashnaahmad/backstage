diff --git a/extensions/tick/bin/backends/aws.mjs b/extensions/tick/bin/backends/aws.mjs
new file mode 100644
index 0000000..041d063
--- /dev/null
+++ b/extensions/tick/bin/backends/aws.mjs
@@ -0,0 +1,81 @@
+// backends/aws.mjs — AWS backend for one-shot jobs (harness patch).
+//
+// The schedule, launch and result live in AWS: an EventBridge Scheduler
+// `at()` schedule invokes a launch Lambda that starts a pi-cloud-agents
+// MicroVM run and submits the prompt; the run's session mirror in S3 holds
+// the result. Nothing local fires the job, so it runs while this machine is
+// asleep. This module only calls the pi-cloud-agents helper CLI
+// (dist/scheduled/cli.js), which takes and prints JSON; the helper path comes
+// from PI_TICK_AWS_HELPER or `awsHelper` in the tick config.json.
+//
+// Selected per job (`runner: "aws"`), never as the platform default, so
+// local launchd/cron jobs are unaffected.
+
+import { spawn } from "node:child_process";
+import { loadConfig } from "../catalog.mjs";
+
+const HELPER_TIMEOUT_MS = 120_000;
+
+export function awsHelperPath() {
+  return process.env.PI_TICK_AWS_HELPER || loadConfig().awsHelper || null;
+}
+
+export function callAwsHelper(command, input) {
+  const helper = awsHelperPath();
+  if (!helper) {
+    return Promise.resolve({ ok: false, error: "AWS helper not configured: set awsHelper in the tick config.json to pi-cloud-agents/dist/scheduled/cli.js" });
+  }
+  return new Promise((resolve) => {
+    const child = spawn(process.execPath, [helper, command, JSON.stringify(input)], {
+      stdio: ["ignore", "pipe", "pipe"],
+      timeout: HELPER_TIMEOUT_MS,
+    });
+    let stdout = "";
+    let stderr = "";
+    child.stdout.on("data", (d) => { stdout += d; });
+    child.stderr.on("data", (d) => { stderr += d; });
+    child.on("error", (err) => resolve({ ok: false, error: `AWS helper failed to start: ${err.message}` }));
+    child.on("close", (code, signal) => {
+      const last = stdout.trim().split("\n").pop() || "";
+      try {
+        resolve(JSON.parse(last));
+      } catch {
+        const why = signal ? `signal ${signal}` : `exit ${code}`;
+        resolve({ ok: false, error: `AWS helper ${command} gave no JSON (${why}): ${(stderr || stdout).trim().slice(-500)}` });
+      }
+    });
+  });
+}
+
+export const awsBackend = {
+  name: "aws",
+  minimumIntervalSeconds: 60,
+  label: (jobId) => `tick-${jobId}`,
+  listRegistered: async () => [],
+  register: async (job) => {
+    if (job.schedule?.kind !== "once") {
+      return { ok: false, error: `the aws runner supports one-shot jobs only (kind 'once')` };
+    }
+    const res = await callAwsHelper("schedule", {
+      jobId: job.id,
+      prompt: job.prompt,
+      cwd: job.cwd,
+      at: job.schedule.value.at,
+      model: job.model,
+      maxDurationSec: job.timeoutMs ? Math.ceil(job.timeoutMs / 1000) : undefined,
+    });
+    if (!res.ok) return { ok: false, error: `aws schedule failed: ${res.error}` };
+    const { ok: _ok, warnings, ...remote } = res;
+    return { ok: true, referencePath: res.scheduleArn, remote, warnings };
+  },
+  unregister: async (jobId) => {
+    const res = await callAwsHelper("cancel", { jobId });
+    if (!res.ok) return { ok: false, error: `aws cancel failed: ${res.error}` };
+    return { ok: true, referencePath: `${res.scheduleName} (${res.deleted ? "deleted" : "already gone"})` };
+  },
+  unregisterAndDelete: async (jobId) => awsBackend.unregister(jobId),
+  result: async (job) => {
+    if (!job.remote?.runId) return { ok: false, error: `job '${job.id}' has not been scheduled in AWS` };
+    return callAwsHelper("result", { runId: job.remote.runId, jobId: job.id });
+  },
+};
