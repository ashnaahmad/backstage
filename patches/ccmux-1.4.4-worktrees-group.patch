+/**
+ * Harness: sessions in agent-made worktrees (a folder inside one named `*-worktrees`, such as
+ * `example-worktrees/task-123`). Each has an orchestrating agent, so they never join the attention
+ * band; in grouped views they share one collapsible group, always last, with no New Pi button.
+ */
+export const WORKTREES_GROUP_KEY = "\0worktrees";
+export const WORKTREES_GROUP_LABEL = "worktrees";
+export function isWorktreeSession(session: EnrichedSession): boolean {
+  const path = session.worktreeRoot || session.paneCwd || session.cwd || "";
+  return /\/[^/]+-worktrees\/[^/]+/.test(path);
+}
+
+/** Whether a session shows in the `needs attention` band instead of its group. */
+export function inAttentionBand(
+  session: EnrichedSession,
+  attentionBand = true,
+): boolean {
+  return (
+    attentionBand && session.status === "waiting" && !isWorktreeSession(session)
+  );
+}
