+    expect(isWorktreeSession(prospect.session)).toBe(false);
+  });
+
+  it("collapses like any group and keeps its key in every grouped mode", () => {
+    const items = buildFlatItems([wt("a", "gal-1"), main("m")], "project", new Set([WORKTREES_GROUP_KEY]), false);
