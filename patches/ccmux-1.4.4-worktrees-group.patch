+        ...overrides,
+      }),
+    );
+  const main = (id: string, overrides: Partial<EnrichedSession> = {}) =>
+    toFiltered(
+      mockSession({
+        id,
+        cwd: "/home/user/code/example-monorepo",
+        paneCwd: "/home/user/code/example-monorepo",
+        worktreeRoot: "/home/user/code/example-monorepo",
+        mainRepoRoot: "/home/user/code/example-monorepo",
+        ...overrides,
+      }),
+    );
+  // A linked worktree outside a `*-worktrees` folder (a long-lived checkout) keeps its own group.
+  const prospect = toFiltered(
+    mockSession({
+      id: "prospect",
+      cwd: "/home/user/code/demo-project-extra",
+      paneCwd: "/home/user/code/demo-project-extra",
+      worktreeRoot: "/home/user/code/demo-project-extra",
+      mainRepoRoot: "/home/user/code/demo-project",
+    }),
+  );
+  const headers = (items: ReturnType<typeof buildFlatItems>) =>
+    items.flatMap((i) => (i.type === "header" ? [i] : []));
+
+  it("puts every worktree session in one last group, with no New Pi button", () => {
+    const items = buildFlatItems(
+      [wt("a", "gal-1"), main("m"), wt("b", "zzz-task"), prospect],
+      "cwd",
+      new Set(),
+      false,
+      ["\0worktrees", "/home/user/code/demo-project-extra"],
+    );
+    const hs = headers(items);
+    expect(hs.map((h) => h.label)).toEqual([
+      "/home/user/code/demo-project-extra",
+      "/home/user/code/example-monorepo",
+      "worktrees",
+    ]);
+    const last = hs.at(-1)!;
+    expect(last.groupKey).toBe(WORKTREES_GROUP_KEY);
+    expect(last.count).toBe(2);
+    expect(last.newPiCwd).toBeUndefined();
+    expect(hs[0]!.newPiCwd).toBe("/home/user/code/demo-project-extra");
+    expect(hs[1]!.newPiCwd).toBe("/home/user/code/example-monorepo");
+    const rows = items.slice(items.indexOf(last) + 1);
+    expect(rows.map((i) => i.type === "session" && i.filteredSession.session.id)).toEqual(["a", "b"]);
+  });
+
+  it("keeps waiting worktree sessions out of the attention band", () => {
+    const items = buildFlatItems(
