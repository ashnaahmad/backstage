    * before that point. Every field is optional — an older daemon answers
    * without any of them (see the stale-daemon check in `reportMove`).
    */
+  /**
+   * A `+ New Pi` row: Pi in that group's exact directory, in a new window of
+   * this session, which the client then switches to. The same request the
+   * new-session dialog posts, with no dialog in between; one at a time, so a
+   * double click opens one window.
+   */
+  let newPiInFlight = false;
+  async function spawnPiIn(cwd: string): Promise<void> {
+    if (newPiInFlight) return;
+    if (!ensureSameServer()) return;
+    newPiInFlight = true;
+    try {
+      // A sidebar alone in its window has no other pane to resolve; its own
+      // pane still names the session, and a new window never splits it.
+      const callerPane =
+        (await resolveSpawnPane()) ?? process.env.TMUX_PANE ?? null;
+      const response = await fetch(`${getDaemonUrl()}/spawn`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          agent: "pi",
+          cwd,
+          split: false,
+          callerPane: callerPane ?? undefined,
+          detach: false,
+        }),
+      });
+      const body = (await response
+        .json()
+        .catch(() => null)) as SpawnBody | null;
+      if (!response.ok || !body?.paneId) {
+        store.actions.showToast(
+          `New Pi failed: ${body?.error ?? response.statusText}`,
+          4000,
+        );
+        return;
+      }
+      notifyActivePane(body.paneId);
+    } catch (err) {
+      store.actions.showToast(`New Pi failed: ${errText(err)}`, 4000);
+    } finally {
+      newPiInFlight = false;
+    }
+  }
+
   interface SpawnBody {
     paneId?: string;
     error?: string;
