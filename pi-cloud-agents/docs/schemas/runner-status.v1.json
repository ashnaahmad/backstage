{
  "$ref": "#/definitions/RunnerStatus",
  "definitions": {
    "RunnerStatus": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "uptimeSeconds": {
          "type": "number",
          "minimum": 0
        },
        "activeConnections": {
          "type": "integer",
          "minimum": 0
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time"
        },
        "agentState": {
          "type": "string",
          "enum": [
            "starting",
            "streaming",
            "tool",
            "idle",
            "stopped",
            "recovering",
            "failed",
            "completed",
            "terminated"
          ]
        },
        "attachedClientsCount": {
          "type": "integer",
          "minimum": 0
        },
        "idleSince": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "type": "object",
          "properties": {
            "idleGraceSec": {
              "type": "number",
              "minimum": 0
            },
            "suspendAfterIdleSec": {
              "type": "number",
              "minimum": 0
            },
            "terminateAfterSuspendedSec": {
              "type": "number",
              "minimum": 0
            },
            "maxDurationSec": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "idleGraceSec",
            "suspendAfterIdleSec",
            "terminateAfterSuspendedSec",
            "maxDurationSec"
          ],
          "additionalProperties": false
        },
        "suggestedAction": {
          "type": "string",
          "enum": [
            "none",
            "suspend",
            "terminate"
          ]
        },
        "pi": {
          "type": "object",
          "properties": {
            "running": {
              "type": "boolean"
            },
            "pid": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "currentSessionId": {
              "type": "string"
            },
            "lastEventAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "running"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "runId",
        "uptimeSeconds",
        "activeConnections",
        "lastActivityAt",
        "pi"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
